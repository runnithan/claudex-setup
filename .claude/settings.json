{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --delete:*)",
      "Bash(git push --mirror:*)",
      "Bash(git push --prune:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "for f in \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-destructive-push.py\" .claude/hooks/block-destructive-push.py; do [ -f \"$f\" ] && exec python3 \"$f\"; done; exit 0"
          }
        ]
      }
    ]
  }
}
