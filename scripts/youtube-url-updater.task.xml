<?xml version="1.0"?>
<!-- Reference copy of the task scripts/install_scheduled_task.ps1 registers.
     Prefer the installer: it also copies run-hidden.vbs to
     %LOCALAPPDATA%\claudex-setup, which the action below expects to find.
     No encoding in the declaration on purpose: schtasks /create /xml reads the
     file as UTF-16 and rejects encoding="UTF-8" ("unable to switch the
     encoding"), and a UTF-16 file would hide the username from publish.sh's
     scrub and leak check. -->

<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Logon trigger; a 24h in-script gate makes it run at most once a day, anchored to actual PC usage. Discovers new videos and fetches a batch of transcripts.</Description>
    <URI>\YouTube URL Updater</URI>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>YOUR_USER</UserId>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>YOUR_USER</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <Enabled>true</Enabled>
    <StartWhenAvailable>true</StartWhenAvailable>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <ExecutionTimeLimit>PT15M</ExecutionTimeLimit>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Windows\System32\wscript.exe</Command>
      <Arguments>//B "%LOCALAPPDATA%\claudex-setup\run-hidden.vbs"</Arguments>
    </Exec>
  </Actions>
</Task>
